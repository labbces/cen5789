Bootstrap: docker
From: mambaorg/micromamba:1.5.10

%labels
    Author Diego M. Riano-Pachon
    Description CEN5789 - Transcriptomics environment (R + Bioconductor + tools)

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/transcriptomics/bin:/opt/salmon-latest_linux_x86_64/bin:$PATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%files 
    tmp/RAWREADS.tar.gz /opt/data/

%post
    apt-get update && apt-get install -y \
        build-essential \
        wget \
        curl \
        git \
        libblas-dev \
        liblapack-dev \
        gfortran \
        zlib1g-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        libfreetype6-dev \
        libfontconfig1-dev \
        graphviz \
        libgraphviz-dev \
        && rm -rf /var/lib/apt/lists/*

    micromamba create -y -n transcriptomics \
        -c conda-forge -c bioconda \
        python=3.11 \
        r-base=4.5 \
        r-ggplot2 \
        r-readr \
        r-reshape2 \
        r-pheatmap \
        r-mclust \
        bioconductor-tximport \
        bioconductor-deseq2 \
        bioconductor-topgo \
        bioconductor-rgraphviz \
        fastqc \
        bbmap \
        multiqc \
        ffq \
        && micromamba clean --all -y

    micromamba run -n transcriptomics R -e "
        install.packages('BiocManager', repos='https://cloud.r-project.org');
        BiocManager::install(version = '3.22', ask = FALSE, update = FALSE);
        install.packages(
            c('ggVennDiagram'),
            repos='https://cloud.r-project.org'
        )
    "

    micromamba run -n transcriptomics python -c "import sys; print(sys.version)"
    micromamba run -n transcriptomics R -e "library(DESeq2); library(tximport); library(topGO); library(Rgraphviz); cat('R/Bioc OK\n')"


    #salmon
    cd /opt
    wget https://github.com/COMBINE-lab/salmon/releases/download/v1.10.0/salmon-1.10.0_linux_x86_64.tar.gz
    tar xzf salmon-1.10.0_linux_x86_64.tar.gz
    rm -rf salmon-1.10.0_linux_x86_64.tar.gz


    #RNASeq data
    cd /opt/data/
    tar xzf RAWREADS.tar.gz
    rm RAWREADS.tar.gz

%runscript
    exec "$@"
